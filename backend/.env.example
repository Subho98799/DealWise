# Application environment: dev or prod
ENV=

# Runtime app database: PostgreSQL app_user connection, preferably pooled
DATABASE_URL=

# Migration database: PostgreSQL owner connection, direct/non-pooled
MIGRATION_DATABASE_URL=

# Backend test database: app_user connection to a database whose name contains test
TEST_DATABASE_URL=

# Test migration database: PostgreSQL owner connection, direct/non-pooled
TEST_MIGRATION_DATABASE_URL=

# Google OAuth web application client ID
GOOGLE_CLIENT_ID=

# Google OAuth web application client secret
GOOGLE_CLIENT_SECRET=

# Server-side session signing secret; use at least 32 random characters
SESSION_SECRET=

# Browser origin used by the backend and OAuth callbacks
FRONTEND_URL=

# Optional comma-separated Google email addresses granted admin access
ADMIN_EMAILS=

# Optional API rate-limit switch
RATE_LIMIT_ENABLED=

# Optional password used when creating the app_user role
APP_USER_PASSWORD=
